spring.application.name=voice-notes-backend

# File Upload Limits
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=50MB

# MySQL Connection (Update username/password as needed)
spring.datasource.url=jdbc:mysql://localhost:3306/voxnote?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA/Hibernate Config
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# JWT Secret (Should be moved to environment variable in production)
jwt.secret=YOUR_SUPER_SECRET_JWT_KEY_HERE
jwt.expiration=86400000

# Free Tier AI Keys
assemblyai.api.key=YOUR_ASSEMBLYAI_KEY_HERE
gemini.api.key=YOUR_GEMINI_KEY_HERE
audio.storage.path=uploads/

# Spring Mail Configuration
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=YOUR_GMAIL_ADDRESS
spring.mail.password=YOUR_GMAIL_APP_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
